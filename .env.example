# ============================================================================
# 1. FRONTEND PUBLIC CONFIGURATION (Safe for browser / Vite build)
# NEVER put service_role, ADMIN_SECRET_KEY, SEND_SMS_HOOK_SECRET, or MSG91_AUTH_KEY here!
# ============================================================================
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key-here"

# ============================================================================
# 2. NETLIFY FUNCTIONS & EXPRESS SERVER CONFIGURATION (Server-side only)
# ============================================================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-or-publishable-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-backend-service-role-key"

# SERVER-SIDE ADMIN AUTHORIZATION KEY:
# Must be set to a strong custom secret. Default keys ('admin123', 'mattokart') are strictly rejected.
ADMIN_SECRET_KEY="your-strong-random-admin-secret-key"

# ============================================================================
# 3. SUPABASE EDGE FUNCTION SECRETS (Set via Supabase CLI / Dashboard ONLY for send-sms-msg91)
# Do NOT prefix with VITE_! Keep exclusively inside Supabase Edge Function Secrets.
# ============================================================================
# SEND_SMS_HOOK_SECRET="v1,whsec_your_supabase_send_sms_hook_secret"
# MSG91_AUTH_KEY="your-msg91-auth-key"
# MSG91_TEMPLATE_ID="your-msg91-dlt-approved-otp-template-id"
# MSG91_SENDER_ID="MTKART"
# MSG91_OTP_VAR_NAME="OTP"

# ============================================================================
# 4. SELLER IDENTITY VERIFICATION PROVIDER (Optional Business KYC)
# Under the Aadhaar Act, raw 12-digit Aadhaar numbers and Aadhaar OTPs are NEVER collected or stored.
# ============================================================================
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""
KYC_PROVIDER_API_KEY=""

# ============================================================================
# 5. PLATFORM DEFAULTS
# ============================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
