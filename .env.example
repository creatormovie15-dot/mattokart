# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# VITE_SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_PUBLISHABLE_KEY: Your Supabase Publishable / Anon API Key (safe for client side)
# NEVER use service_role secret key in frontend code!
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key-here"

# SUPABASE SERVICE ROLE KEY (Backend only, never in frontend!):
# Used for backend administrative operations and SMS dispatch
SUPABASE_SERVICE_ROLE_KEY="your-backend-service-role-key"

# SMS GATEWAY PROVIDER CONFIGURATION (For live Indian mobile SMS delivery):
# Option A: Twilio SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Option B: MSG91 India SMS Gateway
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# SELLER IDENTITY VERIFICATION PROVIDER (Aadhaar & Business KYC):
# Under the Aadhaar Act, raw 12-digit Aadhaar numbers and Aadhaar OTPs are NEVER collected or stored.
# Verification is conducted via authorized DigiLocker OAuth or partner sandbox.
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""
KYC_PROVIDER_API_KEY=""

# SERVER-SIDE ADMIN AUTHORIZATION KEY:
ADMIN_SECRET_KEY="admin123"

